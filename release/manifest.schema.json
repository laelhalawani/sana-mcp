{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Etals-AiApp/sana-ai-mcp/releases/manifest.schema.json",
  "title": "sana-mcp release manifest",
  "description": "Version 1 standalone distribution contract.",
  "$comment": "Consumers MUST pass schema-valid input through parseReleaseManifest. The strict parser additionally enforces releaseTag/packageVersion equality, unique targets, and case-insensitive uniqueness across all declared release filenames; those relational rules are not expressible in portable draft 2020-12 JSON Schema.",
  "x-sana-strict-parser-required": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "packageVersion",
    "releaseTag",
    "sourceCommit",
    "installerProtocol",
    "lifecycleProtocol",
    "inspectProtocol",
    "semanticCapability",
    "assets"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "installerProtocol": {
      "type": "integer",
      "const": 1
    },
    "lifecycleProtocol": {
      "type": "integer",
      "const": 1
    },
    "inspectProtocol": {
      "type": "integer",
      "const": 1
    },
    "semanticCapability": {
      "const": "keyword"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "safeAssetName": {
      "type": "string",
      "pattern": "^(?=.{1,255}$)(?!.*[. ]$)(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|$))[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "assetName",
        "checksumFileName",
        "sha256"
      ],
      "properties": {
        "target": {
          "enum": [
            "bun-linux-x64",
            "bun-linux-x64-musl",
            "bun-linux-arm64",
            "bun-linux-arm64-musl",
            "bun-darwin-x64",
            "bun-darwin-arm64",
            "bun-windows-x64"
          ]
        },
        "libc": {
          "enum": [
            "glibc",
            "musl"
          ]
        },
        "assetName": {
          "$ref": "#/$defs/safeAssetName"
        },
        "checksumFileName": {
          "$ref": "#/$defs/safeAssetName"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "target": { "const": "bun-linux-x64" },
            "assetName": { "const": "sana-mcp-linux-x64" },
            "checksumFileName": { "const": "sana-mcp-linux-x64.sha256" }
          },
          "required": ["target", "assetName", "checksumFileName"]
        },
        {
          "properties": {
            "target": { "const": "bun-linux-x64-musl" },
            "assetName": { "const": "sana-mcp-linux-x64-musl" },
            "checksumFileName": { "const": "sana-mcp-linux-x64-musl.sha256" }
          },
          "required": ["target", "assetName", "checksumFileName"]
        },
        {
          "properties": {
            "target": { "const": "bun-linux-arm64" },
            "assetName": { "const": "sana-mcp-linux-arm64" },
            "checksumFileName": { "const": "sana-mcp-linux-arm64.sha256" }
          },
          "required": ["target", "assetName", "checksumFileName"]
        },
        {
          "properties": {
            "target": { "const": "bun-linux-arm64-musl" },
            "assetName": { "const": "sana-mcp-linux-arm64-musl" },
            "checksumFileName": { "const": "sana-mcp-linux-arm64-musl.sha256" }
          },
          "required": ["target", "assetName", "checksumFileName"]
        },
        {
          "properties": {
            "target": { "const": "bun-darwin-x64" },
            "assetName": { "const": "sana-mcp-darwin-x64" },
            "checksumFileName": { "const": "sana-mcp-darwin-x64.sha256" }
          },
          "required": ["target", "assetName", "checksumFileName"]
        },
        {
          "properties": {
            "target": { "const": "bun-darwin-arm64" },
            "assetName": { "const": "sana-mcp-darwin-arm64" },
            "checksumFileName": { "const": "sana-mcp-darwin-arm64.sha256" }
          },
          "required": ["target", "assetName", "checksumFileName"]
        },
        {
          "properties": {
            "target": { "const": "bun-windows-x64" },
            "assetName": { "const": "sana-mcp-windows-x64.exe" },
            "checksumFileName": { "const": "sana-mcp-windows-x64.exe.sha256" }
          },
          "required": ["target", "assetName", "checksumFileName"]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "enum": [
                  "bun-linux-x64",
                  "bun-linux-arm64"
                ]
              }
            },
            "required": [
              "target"
            ]
          },
          "then": {
            "properties": {
              "libc": {
                "const": "glibc"
              }
            },
            "required": [
              "libc"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "enum": [
                  "bun-linux-x64-musl",
                  "bun-linux-arm64-musl"
                ]
              }
            },
            "required": [
              "target"
            ]
          },
          "then": {
            "properties": {
              "libc": {
                "const": "musl"
              }
            },
            "required": [
              "libc"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "enum": [
                  "bun-darwin-x64",
                  "bun-darwin-arm64",
                  "bun-windows-x64"
                ]
              }
            },
            "required": [
              "target"
            ]
          },
          "then": {
            "not": {
              "required": [
                "libc"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "enum": [
                  "bun-windows-x64"
                ]
              }
            },
            "required": [
              "target"
            ]
          },
          "then": {
            "properties": {
              "assetName": {
                "type": "string",
                "pattern": "\\.[eE][xX][eE]$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "enum": [
                  "bun-linux-x64",
                  "bun-linux-x64-musl",
                  "bun-linux-arm64",
                  "bun-linux-arm64-musl",
                  "bun-darwin-x64",
                  "bun-darwin-arm64"
                ]
              }
            },
            "required": [
              "target"
            ]
          },
          "then": {
            "properties": {
              "assetName": {
                "type": "string",
                "not": {
                  "type": "string",
                  "pattern": "\\.[eE][xX][eE]$"
                }
              }
            }
          }
        }
      ]
    }
  }
}
